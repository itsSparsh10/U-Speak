
# MongoDB Configuration
# For local MongoDB (default)
MONGODB_URI=mongodb://localhost:27017/uspeak-pro

# For Docker MongoDB (uncomment and use this instead)
# MONGODB_URI=mongodb://admin:password123@localhost:27017/uspeak-pro?authSource=admin

# For MongoDB Atlas (uncomment and use this instead)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/uspeak-pro?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key

# Security Configuration
# Enable admin cross-account access (true/false)
ENABLE_ADMIN_CROSS_ACCOUNT=true

# Enable strict account isolation for non-admin users (true/false)
STRICT_ACCOUNT_ISOLATION=true

# Enable admin global access to all accounts when accountId is null (true/false)
ADMIN_GLOBAL_ACCESS=true

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Feature Flags
# Enable frequency data in API responses (true/false)
ENABLE_FREQUENCY_DATA=true

# Enable advanced filtering capabilities (true/false)
ENABLE_ADVANCED_FILTERING=true

# Enable audit logging for admin actions (true/false)
ENABLE_AUDIT_LOGGING=false

# Performance Configuration
# MongoDB aggregation timeout in milliseconds
AGGREGATION_TIMEOUT_MS=30000

# Allow MongoDB aggregation to use disk for large operations (true/false)
AGGREGATION_ALLOW_DISK_USE=false

# Cache configuration
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000
