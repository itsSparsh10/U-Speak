# MongoDB Configuration
# For local MongoDB (default)
MONGODB_URI=mongodb://localhost:27017/uspeak-pro

# For Docker MongoDB (uncomment and use this instead)
# MONGODB_URI=mongodb://admin:password123@localhost:27017/uspeak-pro?authSource=admin

# For MongoDB Atlas (uncomment and use this instead)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/uspeak-pro?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key
