# =============================================================================
# U-SPEAK PRO 4.4 - COMPREHENSIVE ENVIRONMENT CONFIGURATION REFERENCE
# =============================================================================
# This file contains all environment variables used throughout the U-Speak 
# codebase. Copy this file to .env.local and update the values as needed.
#
# Security Note: Never commit sensitive credentials to version control!
# =============================================================================

# =============================================================================
# 🗄️  DATABASE CONFIGURATION
# =============================================================================

# MongoDB Connection URI - Choose one of the following options:

# Option 1: Local MongoDB (Default Development Setup)
MONGODB_URI=mongodb://localhost:27017/uspeak-pro

# Option 2: Docker MongoDB (When using docker-compose.yml)
# MONGODB_URI=mongodb://admin:password123@localhost:27017/uspeak-pro?authSource=admin

# Option 3: MongoDB Atlas Cloud (Production Recommended)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/uspeak-pro?retryWrites=true&w=majority

# Option 4: Remote MongoDB with Authentication
# MONGODB_URI=mongodb://username:password@hostname:27017/uspeak-pro

# Database Name (extracted from URI if not specified)
DATABASE_NAME=uspeak-pro

# =============================================================================
# 🔐 AUTHENTICATION & SECURITY
# =============================================================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-REPLACE-THIS-IN-PRODUCTION
JWT_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# NextAuth Configuration (if using NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-REPLACE-THIS-IN-PRODUCTION

# Password Hashing Configuration
BCRYPT_ROUNDS=12

# Session Configuration
SESSION_TIMEOUT_HOURS=24
SESSION_REFRESH_THRESHOLD_MINUTES=30

# =============================================================================
# 🏢 MULTI-TENANT & ACCESS CONTROL
# =============================================================================

# Admin Cross-Account Access Control
# Allow CORPORATE_ADMIN users to access other accounts (true/false)
ENABLE_ADMIN_CROSS_ACCOUNT=true

# Strict Account Isolation for Regular Users
# Enforce strict data isolation for non-admin users (true/false)
STRICT_ACCOUNT_ISOLATION=true

# Global Admin Access
# Allow admins to access all accounts when accountId is null (true/false)
ADMIN_GLOBAL_ACCESS=true

# Super Admin Configuration
# List of user IDs that have super admin privileges (comma-separated)
SUPER_ADMIN_USER_IDS=

# Account Creation Settings
MAX_ACCOUNTS_PER_ADMIN=5
DEFAULT_ACCOUNT_PLAN=basic
TRIAL_PERIOD_DAYS=30

# =============================================================================
# 🌐 CORS & API SECURITY
# =============================================================================

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# Allowed HTTP Methods
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH

# Allowed Headers
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL=true

# =============================================================================
# 🎛️  FEATURE FLAGS & TOGGLES
# =============================================================================

# Core Feature Toggles
ENABLE_USER_REGISTRATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_TWO_FACTOR_AUTH=false

# Analytics & Reporting Features
ENABLE_FREQUENCY_DATA=true
ENABLE_ADVANCED_FILTERING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true

# Assignment Management Features
ENABLE_BULK_ASSIGNMENTS=true
ENABLE_WORK_REPORTS=true
ENABLE_AUTO_STATUS_UPDATES=true
ENABLE_ASSIGNMENT_NOTIFICATIONS=false

# Employee Management Features
ENABLE_BULK_EMPLOYEE_IMPORT=true
ENABLE_EMPLOYEE_EXPORT=true
ENABLE_CUSTOM_ATTRIBUTES=true
ENABLE_EMPLOYEE_SELF_SERVICE=false

# Video & Media Features
ENABLE_VIDEO_UPLOADS=true
ENABLE_VIDEO_PROCESSING=false
ENABLE_VIDEO_ANALYTICS=true
MAX_VIDEO_SIZE_MB=500

# =============================================================================
# 📧 EMAIL & NOTIFICATIONS
# =============================================================================

# SMTP Configuration (for email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=U-Speak Pro
SMTP_FROM_EMAIL=noreply@yourcompany.com

# Email Templates
EMAIL_VERIFICATION_TEMPLATE=email-verification
PASSWORD_RESET_TEMPLATE=password-reset
WELCOME_EMAIL_TEMPLATE=welcome

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_IN_APP_NOTIFICATIONS=true
NOTIFICATION_BATCH_SIZE=50

# =============================================================================
# 🚀 PERFORMANCE & OPTIMIZATION
# =============================================================================

# MongoDB Performance Settings
AGGREGATION_TIMEOUT_MS=30000
AGGREGATION_ALLOW_DISK_USE=true
MAX_POOL_SIZE=10
SERVER_SELECTION_TIMEOUT_MS=5000
SOCKET_TIMEOUT_MS=45000

# Caching Configuration
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000
ENABLE_QUERY_CACHE=true
REDIS_URL=redis://localhost:6379

# Pagination Defaults
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=1000
DEFAULT_PAGE=1

# API Response Optimization
ENABLE_RESPONSE_COMPRESSION=true
COMPRESS_THRESHOLD_BYTES=1024

# =============================================================================
# 📊 LOGGING & MONITORING
# =============================================================================

# Log Levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info
LOG_FILE_PATH=logs/application.log
LOG_MAX_FILE_SIZE=10M
LOG_MAX_FILES=5

# Error Tracking (Sentry, etc.)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
ENABLE_ERROR_TRACKING=false

# Application Monitoring
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_ENDPOINT=/api/health
METRICS_ENDPOINT=/api/metrics

# =============================================================================
# 🔧 DEVELOPMENT & TESTING
# =============================================================================

# Environment
NODE_ENV=development

# Development Tools
ENABLE_DEBUG_LOGS=true
ENABLE_QUERY_LOGGING=false
ENABLE_REQUEST_LOGGING=true

# Testing Configuration
TEST_DATABASE_URI=mongodb://localhost:27017/uspeak-test
ENABLE_TEST_DATA_SEEDING=true
TEST_JWT_SECRET=test-secret-key-for-development-only

# Mock Data & Seeding
SEED_SAMPLE_DATA=false
SAMPLE_DATA_SIZE=100
GENERATE_TEST_USERS=false

# =============================================================================
# 🎨 UI/UX & CLIENT-SIDE CONFIGURATION
# =============================================================================

# Application Branding
APP_NAME=U-Speak Pro
APP_VERSION=4.4.0
APP_LOGO_URL=/images/logo.png
DEFAULT_THEME=light

# Client-side API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_APP_VERSION=4.4.0

# Upload Configuration
MAX_FILE_UPLOAD_SIZE=10MB
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.pdf,.docx,.xlsx
UPLOAD_DESTINATION=uploads

# =============================================================================
# 🔌 THIRD-PARTY INTEGRATIONS
# =============================================================================

# AWS Configuration (if using AWS services)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=uspeak-uploads

# Google Services (OAuth, Analytics, etc.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANALYTICS_ID=

# Microsoft Integration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Syncfusion License (for rich text editor)
SYNCFUSION_LICENSE_KEY=your-syncfusion-license-key

# =============================================================================
# 💼 BUSINESS LOGIC & LIMITS
# =============================================================================

# Account Limits
MAX_EMPLOYEES_PER_ACCOUNT=10000
MAX_ASSIGNMENTS_PER_ACCOUNT=1000
MAX_CUSTOM_ATTRIBUTES=20
MAX_API_REQUESTS_PER_MINUTE=1000

# Subscription Plans
BASIC_PLAN_EMPLOYEE_LIMIT=50
PROFESSIONAL_PLAN_EMPLOYEE_LIMIT=1000
ENTERPRISE_PLAN_EMPLOYEE_LIMIT=50000

# Assignment Configuration
DEFAULT_ASSIGNMENT_DURATION_DAYS=7
MAX_ASSIGNMENT_DURATION_DAYS=365
ENABLE_ASSIGNMENT_REMINDERS=true

# =============================================================================
# 🐳 DOCKER & DEPLOYMENT CONFIGURATION
# =============================================================================

# Docker MongoDB Settings (from docker-compose.yml)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123
MONGO_INITDB_DATABASE=uspeak-pro

# MongoDB Express (Admin Interface)
ME_CONFIG_MONGODB_ADMINUSERNAME=admin
ME_CONFIG_MONGODB_ADMINPASSWORD=password123
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=password123

# Container Configuration
CONTAINER_PORT=3000
CONTAINER_NAME=uspeak-app

# =============================================================================
# 🏃‍♂️ PRODUCTION OPTIMIZATION
# =============================================================================

# Production Performance
ENABLE_STATIC_OPTIMIZATION=true
ENABLE_IMAGE_OPTIMIZATION=true
ENABLE_FONT_OPTIMIZATION=true

# Build Configuration
ANALYZE_BUNDLE=false
DISABLE_ESLINT_PLUGIN=false
EXPERIMENTAL_APP_DIR=true

# CDN Configuration
CDN_BASE_URL=
STATIC_ASSETS_URL=

# =============================================================================
# 📱 MOBILE & PWA CONFIGURATION
# =============================================================================

# Progressive Web App
ENABLE_PWA=false
PWA_THEME_COLOR=#000000
PWA_BACKGROUND_COLOR=#ffffff

# =============================================================================
# 🔍 SEARCH & INDEXING
# =============================================================================

# Search Configuration
ENABLE_FULL_TEXT_SEARCH=true
SEARCH_INDEX_BATCH_SIZE=1000
MAX_SEARCH_RESULTS=100

# =============================================================================
# 🧪 DEVELOPMENT SHORTCUTS & TESTING ACCOUNTS
# =============================================================================

# Test Account Credentials (Development Only - Remove in Production!)
DEV_ADMIN_EMAIL=admin@test.com
DEV_ADMIN_PASSWORD=password123
DEV_EMPLOYEE_EMAIL=employee@test.com
DEV_EMPLOYEE_PASSWORD=password123

# Quick Setup Test Data
DEV_ACCOUNT_ID=68a9866757aef17c0b766996
DEV_USER_ID=68a9866857aef17c0b766998
DEV_INSTANCE_ID=68ad4ff9e8e7313146f6a6d1

# =============================================================================
# 📝 NOTES & REMINDERS
# =============================================================================

# 🔴 SECURITY CHECKLIST FOR PRODUCTION:
# □ Change all default passwords and secrets
# □ Use strong JWT_SECRET (at least 32 characters)
# □ Enable HTTPS and update NEXTAUTH_URL
# □ Configure proper CORS origins
# □ Enable rate limiting
# □ Set up proper monitoring and logging
# □ Remove all DEV_* variables
# □ Use environment-specific MongoDB URI
# □ Enable audit logging for compliance

# 🟡 PERFORMANCE CHECKLIST:
# □ Configure Redis for caching
# □ Optimize MongoDB indexes
# □ Enable response compression
# □ Configure CDN for static assets
# □ Set appropriate cache TTL values

# 🟢 FEATURE CONFIGURATION:
# □ Review and configure feature flags
# □ Set up email service for notifications
# □ Configure file upload limits
# □ Set business rule limits per your needs

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
